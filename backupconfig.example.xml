<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shoebox example config. Copy to /etc/shoebox/backupconfig.xml and edit (the README explains every option).

  This file says WHAT to back up, how to reach the databases and how long to keep the backups. It holds no
  passwords: those, the report email settings and the Dropbox login live in .env (see .env.example).
  Shoebox refuses elements it does not know, so a typo is an error, not a silently ignored option.
  Yes/no values accept yes/no, true/false, y/n or 1/0.
-->
<shoebox>
	<config>
		<archive_label>MYSERVER</archive_label>          <!-- required. In every file name, and the Dropbox folder. Letters, digits, _ . - -->
		<local_folder>/var/backups/shoebox</local_folder>  <!-- default /var/backups/shoebox. One sub-folder per run -->
		<local_keep_days>7</local_keep_days>             <!-- default 7. Local runs older than this are removed -->
		<log_file>/var/log/shoebox/shoebox.log</log_file>        <!-- default: local_folder/shoebox.log -->
		<status_file>/var/log/shoebox/status.json</status_file>  <!-- default: local_folder/status.json. The last run, for monitoring -->
		<dropbox_folder>MYSERVER</dropbox_folder>        <!-- default: archive_label. Folder inside the Dropbox app folder -->
		<dropbox_chunksize>33554432</dropbox_chunksize>  <!-- default 32 MiB. Upload chunk in bytes (4 MiB steps, max 148 MiB) -->
		<tar_exe>tar</tar_exe>                           <!-- default tar. Must be GNU tar -->

		<!-- Dropbox retention: keep the newest run of each of the last N days, weeks and months.
		     Leave the whole element out to keep every run. -->
		<retention>
			<daily>14</daily>
			<weekly>8</weekly>
			<monthly>12</monthly>
		</retention>
	</config>

	<!-- Folders. Each becomes <run>-<archive_label>-<folder_label>-dir.tgz.
	       <folder_label>          required: letters, digits, _ . -
	       <folder_path>           required: the folder to archive
	       <folder_split>          optional yes/no (default no): one archive per sub-folder, named
	                               <folder_label>-<sub-folder>, plus one <folder_label>-_top archive for the
	                               files sitting directly in the folder
	       <folder_split_exclude>  optional, with folder_split: sub-folder names to skip, one <exclude> each
	       <folder_exclude>        optional, repeatable: a GNU tar exclude pattern. Paths in the archive have
	                               no leading /, so write opt/big-thing, not /opt/big-thing -->
	<folder_list>
		<folder>
			<folder_label>WWW</folder_label>
			<folder_path>/var/www/html</folder_path>
			<folder_split>yes</folder_split>             <!-- WWW-site1, WWW-site2, ... and WWW-_top -->
			<folder_split_exclude>
				<exclude>old-site</exclude>
			</folder_split_exclude>
		</folder>
		<folder>
			<folder_label>ETC</folder_label>
			<folder_path>/etc</folder_path>
		</folder>
		<folder>
			<folder_label>OPT</folder_label>
			<folder_path>/opt</folder_path>
			<folder_exclude>opt/big-thing</folder_exclude>
			<folder_exclude>*.tmp</folder_exclude>
		</folder>
	</folder_list>

	<!-- MySQL / MariaDB servers, one <database_server> each. Leave <databases> out to back up no databases.
	     Each database becomes <run>-<archive_label>-<label>-<database>.sql.gz, checked before it counts.
	       <label>                   required: your name for the server (letters, digits, _ . -)
	       <host> or <docker_container>   exactly one: a host name (localhost = this machine, over its socket)
	                                 or a running Docker container (dumped inside it with `docker exec`)
	       <port>                    optional, with <host> only
	       <username>                required
	       <password_env>            the name of a variable in .env that holds the password, or
	       <password_container_env>  the name of a variable INSIDE the container that holds it (Docker only;
	                                 the password never leaves the container), or
	                                 neither: no password (socket login, or ~/.my.cnf on this machine)
	       <mysql_exe>               optional dump program + options. Default: mysqldump (in a container:
	                                 mariadb-dump or mysqldump, whichever it has). The options a restorable
	                                 dump needs are always added; force is ignored.
	       <mysql_query>             optional: which databases. Runs in information_schema; the first column
	                                 is the database name. Default: every database except information_schema,
	                                 performance_schema, mysql and sys. -->
	<databases>
		<database_server>
			<label>host</label>
			<host>localhost</host>
			<username>root</username>                    <!-- no password element: root over the socket -->
			<mysql_exe>mysqldump --add-drop-table</mysql_exe>
			<mysql_query>SELECT SCHEMA_NAME FROM SCHEMATA WHERE SCHEMA_NAME NOT IN ('information_schema','performance_schema','mysql','sys','phpmyadmin')</mysql_query>
		</database_server>
		<database_server>
			<label>shop</label>
			<docker_container>shop-db</docker_container>
			<username>root</username>
			<password_container_env>MARIADB_ROOT_PASSWORD</password_container_env>  <!-- set by the image's environment -->
		</database_server>
		<database_server>
			<label>crm</label>
			<host>db.internal.example</host>
			<port>3306</port>
			<username>backup</username>
			<password_env>CRM_DB_PASSWORD</password_env>  <!-- CRM_DB_PASSWORD=... in .env -->
			<mysql_query>SELECT SCHEMA_NAME FROM SCHEMATA WHERE SCHEMA_NAME IN ('crm')</mysql_query>
		</database_server>
	</databases>
</shoebox>
