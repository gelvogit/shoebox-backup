<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shoebox example config. Copy to backupconfig.xml (git-ignored) and edit.
  This file says WHAT to back up, how to reach the databases, and how long to keep it. It holds no
  passwords: those, the report email settings and the Dropbox login live in .env (see .env.example).
  The email settings are also accepted here as XML elements (email_server, email_username, ...; a .env
  value wins); an email_password here works too, with a warning until it is moved to .env.
-->
<shoebox>
	<config>
		<archive_label>MYSERVER</archive_label>          <!-- used in file names and as the Dropbox folder: letters, digits, _ . - -->
		<local_folder>/var/backups/shoebox/</local_folder>  <!-- one sub-folder per run is kept here -->
		<tar_exe>tar</tar_exe>                           <!-- GNU tar -->
		<dropbox_chunksize>33554432</dropbox_chunksize>  <!-- upload chunk in bytes (4 MiB steps, max 148 MiB); 32 MiB is a good size -->

		<local_keep_days>7</local_keep_days>             <!-- local runs older than this are removed; default 7 -->
		<log_file>/var/log/shoebox/shoebox.log</log_file>        <!-- default: local_folder/shoebox.log -->
		<status_file>/var/log/shoebox/status.json</status_file>  <!-- last run as JSON, for monitoring -->
		<dropbox_folder>MYSERVER</dropbox_folder>        <!-- folder inside the Dropbox app folder; default archive_label -->

		<!-- Dropbox retention: keep the newest run of each of the last N days / weeks / months.
		     Leave the whole element out to keep every run. -->
		<retention>
			<daily>14</daily>
			<weekly>8</weekly>
			<monthly>12</monthly>
		</retention>
	</config>

	<!-- MySQL / MariaDB servers. One <database_server> each; leave <databases> out to back up no databases.
	     Each database becomes <run>-<archive_label>-<label>-<database>.sql.gz, checked before it counts.
	       <label>                   your name for the server (letters, digits, _ . -); used in file names
	       <host> or <docker_container>   exactly one: a host name (localhost = this machine, over its socket)
	                                 or a running Docker container (dumped inside it with `docker exec`)
	       <port>                    optional, with <host> only
	       <username>                required
	       <password_env>            name of a variable in .env that holds the password, or
	       <password_container_env>  name of a variable INSIDE the container that holds it (Docker only;
	                                 the password never leaves the container), or
	                                 neither: no password (socket login, or ~/.my.cnf on this machine)
	       <mysql_exe>               optional dump program + options. Default: mysqldump (in a container:
	                                 mariadb-dump or mysqldump, whichever it has). The options a restorable
	                                 dump needs are always added; force is ignored.
	       <mysql_query>             optional: which databases. Runs in information_schema; the first column
	                                 is the database name. Default: every database except information_schema,
	                                 performance_schema, mysql and sys. -->
	<databases>
		<database_server>
			<label>host</label>
			<host>localhost</host>
			<username>root</username>                    <!-- no password element: root over the socket -->
			<mysql_exe>mysqldump --add-drop-table --single-transaction</mysql_exe>
			<mysql_query>SELECT SCHEMA_NAME FROM SCHEMATA WHERE SCHEMA_NAME NOT IN ('information_schema','performance_schema','mysql','sys','phpmyadmin')</mysql_query>
		</database_server>
		<database_server>
			<label>shop</label>
			<docker_container>shop-db</docker_container>
			<username>root</username>
			<password_container_env>MARIADB_ROOT_PASSWORD</password_container_env>  <!-- set by the image's environment -->
		</database_server>
		<database_server>
			<label>crm</label>
			<docker_container>crm-mysql</docker_container>
			<username>backup</username>
			<password_env>CRM_DB_PASSWORD</password_env>  <!-- CRM_DB_PASSWORD=... in .env -->
			<mysql_query>SELECT SCHEMA_NAME FROM SCHEMATA WHERE SCHEMA_NAME IN ('crm')</mysql_query>
		</database_server>
	</databases>

	<folder_list>
		<!-- folder_split y: one archive per sub-folder (plus one "-_top" archive for loose files at the top) -->
		<folder>
			<folder_label>WWW</folder_label>
			<folder_path>/var/www/html/</folder_path>
			<folder_split>y</folder_split>
			<folder_split_exclude>
				<exclude>TODELETE</exclude>          <!-- sub-folder names to skip -->
			</folder_split_exclude>
		</folder>
		<folder>
			<folder_label>ETC</folder_label>
			<folder_path>/etc/</folder_path>
			<folder_split>n</folder_split>
		</folder>
		<folder>
			<folder_label>OPT</folder_label>
			<folder_path>/opt/</folder_path>
			<folder_split>n</folder_split>
			<folder_exclude>opt/big-thing</folder_exclude>  <!-- tar exclude pattern (paths have no leading /); repeat the element for more -->
		</folder>
	</folder_list>
</shoebox>
