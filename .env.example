# Shoebox settings for THIS server: connections and logins. Copy to .env (next to your
# backupconfig.xml), then: chmod 600 .env. Never commit .env.
# backupconfig.xml says WHAT to back up; this file says how to reach things and who gets the report.
# (These can also be XML elements in backupconfig.xml; a value here wins.)

# Dropbox app (Scoped access, App folder). `shoebox.py auth` fills these in for you.
# PKCE is used, so the app secret is optional.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Report email. One setting per line, no comments after a value (a # can be part of a password).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_SECURE: tls (STARTTLS), ssl, or empty. SMTP_AUTH: n for an open relay.
SMTP_SECURE=tls
SMTP_AUTH=y
SMTP_USERNAME=smtp-user
SMTP_PASSWORD=
EMAIL_TO=you@example.com
EMAIL_FROM=backups@example.com
EMAIL_FROM_NAME=Shoebox

# Host MySQL/MariaDB (used when <mysql>y</mysql> in the XML). Leave the password empty for socket auth
# (root on Ubuntu/Debian) or when ~/.my.cnf has it. Docker containers use their own
# MARIADB_ROOT_PASSWORD instead.
MYSQL_HOST=localhost
MYSQL_USERNAME=root
MYSQL_PASSWORD=
