# Shoebox secrets for THIS server: the Dropbox login, the report email and database passwords.
# Copy to .env next to your backupconfig.xml (e.g. /etc/shoebox/.env), then: chmod 600 .env
# Never commit it. One KEY=value per line; no comments after a value (a # can be part of a password).

# Dropbox app (Scoped access, App folder). `shoebox.py auth` asks for the key and fills in the token.
DROPBOX_APP_KEY=
DROPBOX_REFRESH_TOKEN=
# Only if you logged in some other way than `auth` (PKCE needs no secret):
# DROPBOX_APP_SECRET=

# Report email, sent after every run. Leave SMTP_HOST empty to send no email.
SMTP_HOST=smtp.example.com
# 587 for tls (STARTTLS), 465 for ssl, 25 for a plain local relay
SMTP_PORT=587
# tls, ssl, or empty for none
SMTP_SECURE=tls
# no for a relay that needs no login
SMTP_AUTH=yes
SMTP_USERNAME=smtp-user
SMTP_PASSWORD=
EMAIL_TO=you@example.com
EMAIL_FROM=backups@example.com
EMAIL_FROM_NAME=Shoebox

# Database passwords: one variable per <database_server> that has <password_env>NAME</password_env>.
# The names are yours to choose; this one matches backupconfig.example.xml.
CRM_DB_PASSWORD=
