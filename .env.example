# Shoebox settings for THIS server: passwords, the report email and Dropbox. Copy to .env (next to your
# backupconfig.xml), then: chmod 600 .env. Never commit .env.
# backupconfig.xml says WHAT to back up and holds no passwords; this file has the secrets and who gets
# the report. (The email settings can also be XML elements; a value here wins.)

# Dropbox app (Scoped access, App folder). `shoebox.py auth` fills these in for you.
# PKCE is used, so the app secret is optional.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Report email. One setting per line, no comments after a value (a # can be part of a password).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_SECURE: tls (STARTTLS), ssl, or empty. SMTP_AUTH: n for an open relay.
SMTP_SECURE=tls
SMTP_AUTH=y
SMTP_USERNAME=smtp-user
SMTP_PASSWORD=
EMAIL_TO=you@example.com
EMAIL_FROM=backups@example.com
EMAIL_FROM_NAME=Shoebox

# Database passwords: one variable per <database_server> that has <password_env>NAME</password_env>.
# The names are yours to choose; these match backupconfig.example.xml.
CRM_DB_PASSWORD=
